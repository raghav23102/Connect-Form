// Connect Form - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id                 String    @id @default(cuid())
  shopDomain         String    @unique
  plan               String    @default("free")
  subscriptionStatus String    @default("active")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  forms         Form[]
  submissions   Submission[]
  emailLogs     EmailLog[]
  subscriptions Subscription[]
  settings      ShopSettings?
}

model ShopSettings {
  id                String   @id @default(cuid())
  shopId            String   @unique
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  storeName         String?
  notificationEmail String?
  senderName        String   @default("Connect Form")
  replyToEmail      String?
  autoResponseEnabled Boolean @default(false)
  autoResponseSubject String @default("We received your message")
  autoResponseBody  String  @default("Thank you for contacting us. We have received your request and our team will get back to you shortly.")
  submissionRetentionDays Int @default(365)
  spamProtection    Boolean  @default(true)
  duplicateProtection Boolean @default(false)
  defaultDesign     String   @default("classic")
  defaultButtonText String   @default("Send Message")
  defaultSuccessMessage String @default("Thank you! Your message has been received.")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Form {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  formId      String   @unique  // e.g. connect-form-A8F92K
  name        String
  description String?
  design      String   @default("classic")
  status      String   @default("draft") // draft | active | disabled
  styling     String   @default("{}")     // JSON string
  settings    String   @default("{}")     // JSON string
  fields      String   @default("[]")     // JSON string
  logic       String   @default("[]")     // JSON string for conditional logic
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions       Submission[]
  notificationRules NotificationRule[]
}

model Submission {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  formId       String
  form         Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  submissionId String   @unique  // e.g. sub-A8F92K-001
  data         String   @default("{}") // JSON string of submitted field values
  category     String?
  status       String   @default("new") // new | read | replied | archived
  ipAddress    String?
  createdAt    DateTime @default(now())

  emailLogs EmailLog[]
}

model NotificationRule {
  id        String  @id @default(cuid())
  formId    String
  form      Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  name      String?
  condition String  @default("{}") // JSON - {field, operator, value}
  recipient String
  cc        String?
  bcc       String?
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id           String    @id @default(cuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  recipient    String
  type         String    // notification | auto-response | forward | routing
  status       String    @default("pending") // pending | sent | failed
  error        String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
}

model Subscription {
  id                     String    @id @default(cuid())
  shopId                 String
  shop                   Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan                   String
  shopifySubscriptionId  String?
  status                 String    @default("active")
  createdAt              DateTime  @default(now())
  renewalDate            DateTime?
  updatedAt              DateTime  @updatedAt
}
